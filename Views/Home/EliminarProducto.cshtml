@model AppProductos.Models.Producto;

@{
    ViewData["Title"] = "Eliminar Producto";
}

<h2>¿Estás seguro de que deseas eliminar este producto?</h2>

<div>
    <h3>@Model.Nombre</h3>
    <p>Precio: @Model.Precio</p>
    <p>Categoría: @Model.Categoria</p>
    <p>Descripción: @Model.Descripcion</p>
</div>

<form asp-action="ConfirmarEliminar" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn custom-light-red-btn">Eliminar</button>
    <a href="@Url.Action("Products")" class="btn btn-secondary">Cancelar</a>
</form>
