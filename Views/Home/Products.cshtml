@model IEnumerable<AppProductos.Models.Producto>

@{
    ViewData["Title"] = "Products page";
}

<h2>Lista de productos</h2>

<form method="get" action="/Home/BuscarProducto" class="mt-3">
    <div class="input-group mb-3">
        <input type="text" name="query" class="form-control" placeholder="Buscar producto" />
        <button type="submit" class="btn btn-info">Buscar</button>
    </div>
</form>

<a href="/Home/AgregarProducto" class="btn btn-info">Agregar producto</a>



<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Categoria</th>
            <th>Descripción</th>
            <th>Funciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Nombre</td>
                <td>@producto.Precio</td>
                <td>@producto.Categoria</td>
                <td>@producto.Descripcion</td>
                <td>
                    <a href="@Url.Action("EditarProducto", "Home", new { id = producto.Id })" class="btn custom-light-yellow-btn">Editar</a>
                    <a href="@Url.Action("EliminarProducto", "Home", new { id = producto.Id })" class="btn custom-light-red-btn">Eliminar</a>
                </td>
            </tr>
        }
</table>
