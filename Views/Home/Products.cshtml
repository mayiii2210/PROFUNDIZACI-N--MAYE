@model IEnumerable<AppProductos.Models.Producto>

@{
    ViewData["Title"] = "Products page";
}

<h2>Lista de productos</h2>

<a href="/Home/AgregarProducto" class="btn btn-primary">Agregar producto</a>



<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Categoria</th>
            <th>Funciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Nombre</td>
                <td>@producto.Precio</td>
                <td>@producto.Categoria</td>
                <td>
                    <a href="@Url.Action("EditarProducto", "Home", new { id = producto.Id })" class="btn btn-warning">Editar</a>
                    <a href="@Url.Action("EliminarProducto", "Home", new { id = producto.Id })" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
</table>
