@model AppProductos.Models.Producto;

@{
    ViewData["Title"] = "Editar Producto";
}

<h2>Editar Producto</h2>

<form asp-action="EditarProducto" method="post">
    <div class="form-group">
        <label for="Nombre">Nombre</label>
        <input type="text" class="form-control" id="Nombre" name="Nombre" value="@Model.Nombre" required />
    </div>
    <div class="form-group">
        <label for="Precio">Precio</label>
        <input type="number" class="form-control" id="Precio" name="Precio" value="@Model.Precio" required />
    </div>
    <div class="form-group">
        <label for="Categoria">Categoría</label>
        <input type="text" class="form-control" id="Categoria" name="Categoria" value="@Model.Categoria" required />
    </div>
    <div class="form-group">
        <label for="Descripcion">Descripción</label>
        <textarea class="form-control" id="Descripcion" name="Descripcion">@Model.Descripcion</textarea>
    </div>

    <button type="submit" class="btn btn-info">Actualizar</button>
    <a href="@Url.Action("Products")" class="btn btn-secondary">Cancelar</a>
</form>
